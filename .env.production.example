# OpenPay — Production Environment Template
# Copy to .env on the production host, fill every value, then run:
#   ./scripts/validate-config.sh   # (verify this file with: cp .env.production.example .env && validate-config.sh)
#
# Hardening rules enforced by validate-config.sh (--prod mode):
#   - No value may contain placeholder markers (your_, pk_test_, changeme, …).
#   - Every *_URL value must be a real http(s) endpoint.

COMPOSE_PROJECT_NAME=openpay-prod
ENVIRONMENT=production
LOG_LEVEL=info

# Traefik Proxy
TRAEFIK_API_INSECURE=false
TRAEFIK_DASHBOARD=false

# NATS JetStream (use the in-cluster DNS name; the host ports are internal)
NATS_URL=nats://nats:4222
NATS_MONITORING_URL=http://nats:8222

# Hyperswitch — production router endpoint. TLS terminates at Traefik.
HYPERSWITCH_URL_TEST=https://sandbox-router.yourdomain.com
HYPERSWITCH_API_KEY_TEST=use_a_vault_stored_sandbox_key
HYPERSWITCH_URL_LIVE=https://router.yourdomain.com
HYPERSWITCH_API_KEY_LIVE=use_a_vault_stored_live_key
HYPERSWITCH_API_KEY=use_a_vault_stored_live_key
HYPERSWITCH_API_URL=http://hyperswitch:8080

# Paystack — live keys only in production
PAYSTACK_SECRET_KEY=use_a_vault_stored_live_secret_key
PAYSTACK_PUBLIC_KEY=use_a_vault_stored_live_public_key
PAYSTACK_WEBHOOK_SECRET=use_a_vault_stored_webhook_secret
PAYSTACK_BASE_URL=https://api.paystack.co

# Kill Bill
KILLBILL_API_KEY=use_a_vault_stored_api_key
KILLBILL_API_SECRET=use_a_vault_stored_api_secret
KILLBILL_API_URL=http://killbill:8080

# Tazama
TAZAMA_API_URL=http://tazama-rule-exec:8080
TAZAMA_AUTH_URL=http://tazama-auth:8080

# Database — rotate these; never commit real values
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=coreplatform
POSTGRES_PASSWORD=use_a_vault_stored_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=use_a_vault_stored_password

# Hyperswitch security — 64-char random hex + random API key (openssl rand -hex 32)
HYPERSWITCH_JWT_SECRET=use_a_vault_stored_64_hex
HYPERSWITCH_ADMIN_API_KEY=use_a_vault_stored_api_key

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=use_a_vault_stored_password

# Email delivery — real SMTP provider + public dashboard URL
EMAIL_ACTIVE_CLIENT=SMTP
EMAIL_SENDER_EMAIL=no-reply@yourdomain.com
EMAIL_SMTP_HOST=smtp.postmarkapp.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_CONNECTION=start_tls
EMAIL_SMTP_TIMEOUT=10
EMAIL_SMTP_USERNAME=use_a_vault_stored_smtp_username
EMAIL_SMTP_PASSWORD=use_a_vault_stored_smtp_password
HYPERSWITCH_DASHBOARD_URL=https://dashboard.yourdomain.com
HYPERSWITCH_PUBLIC_API_URL=https://router.yourdomain.com
HYPER_EMAIL_ENABLED=true
