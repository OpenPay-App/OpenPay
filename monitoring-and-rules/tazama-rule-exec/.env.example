# Tazama Rule Execution Engine Configuration

# Server Configuration
RULE_EXEC_HOST=0.0.0.0
RULE_EXEC_PORT=8080

# NATS Configuration
NATS_URL=nats://nats:4222
NATS_USER=core-nats-user
NATS_PASSWORD=your_nats_password_here
NATS_STREAM=PAYMENT_EVENTS
NATS_CONSUMER=fraud-detection

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=tazama_rules
DATABASE_USER=tazama_rules_user
DATABASE_PASSWORD=your_database_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Rule Engine Configuration
RULES_DIRECTORY=/etc/tazama/rules
RULE_CACHE_TTL=300
MAX_CONCURRENT_RULES=100

# Auth Service Configuration
TAZAMA_AUTH_URL=http://tazama-auth:8080
TAZAMA_API_KEY=your_api_key_here

# Logging Configuration
LOG_LEVEL=info

# Paystack Integration
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# Risk Scoring Configuration
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80

# Fraud Detection Rules
ENABLE_VELOCITY_CHECK=true
VELOCITY_WINDOW_MINUTES=60
VELOCITY_MAX_ATTEMPTS=5

ENABLE_GEO_VELOCITY=true
GEO_VELOCITY_MAX_KM=500
GEO_VELOCITY_TIME_WINDOW_HOURS=24