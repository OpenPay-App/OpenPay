# Shared Base Secrets for Tazama Suite

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=tazama
DATABASE_USER=tazama_user
DATABASE_PASSWORD=your_database_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# NATS Configuration (for event processing)
NATS_URL=nats://nats:4222
NATS_USER=core-nats-user
NATS_PASSWORD=your_nats_password_here
NATS_STREAM=PAYMENT_EVENTS

# Paystack Integration
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here
# Tazama Auth Service URL
TAZAMA_AUTH_URL=http://tazama-auth:8083
