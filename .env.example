# Master Deployment Environment Template
# Copy this file to .env and fill in the values

# General Configuration
COMPOSE_PROJECT_NAME=core-financial-platform
ENVIRONMENT=development
LOG_LEVEL=info

# Traefik Proxy
TRAEFIK_API_INSECURE=true
TRAEFIK_DASHBOARD=true

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_MONITORING_URL=http://nats:8222

# Hyperswitch (Payment Orchestration)
# Phase 3: per-mode credential pairs. The dashboard resolves sandbox vs live
# via the `openpay_mode` cookie and never reuses a test key for a live request.
HYPERSWITCH_URL_TEST=http://hyperswitch:8080
HYPERSWITCH_API_KEY_TEST=your_hyperswitch_sandbox_api_key
HYPERSWITCH_URL_LIVE=https://router.yourdomain.com
HYPERSWITCH_API_KEY_LIVE=your_hyperswitch_live_api_key
# Legacy fallback (single-mode installs):
HYPERSWITCH_API_KEY=your_hyperswitch_api_key
HYPERSWITCH_API_URL=http://hyperswitch:8080

# Paystack Integration
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Kill Bill (Subscription Billing)
KILLBILL_API_KEY=your_killbill_api_key
KILLBILL_API_SECRET=your_killbill_api_secret
KILLBILL_API_URL=http://killbill:8080

# Tazama (Fraud Detection)
TAZAMA_API_URL=http://tazama-rule-exec:8080
TAZAMA_AUTH_URL=http://tazama-auth:8080

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=coreplatform
POSTGRES_PASSWORD=your_database_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Hyperswitch Security (generate strong random values for production)
HYPERSWITCH_JWT_SECRET=generate_a_random_64_char_hex_string
HYPERSWITCH_ADMIN_API_KEY=generate_a_random_api_key

# Grafana Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Hyperswitch Email Delivery (team invites / verification / magic links) ───
# Provider-agnostic SMTP: any provider works (Resend, SES, SendGrid, Postmark, Brevo,
# Mailchimp/Mandrill, Mailgun...). Every provider matrix + links: /docs/self-hosting/email-delivery.
# Dev default targets the bundled MailHog catcher (docker compose --profile dev up -d mailhog).
# Web UI: http://localhost:8025
EMAIL_ACTIVE_CLIENT=SMTP
EMAIL_SENDER_EMAIL=no-reply@yourdomain.com
# Dev/MailHog:   mailhog / 1025 / plaintext
# Resend:        smtp.resend.com / 587 / start_tls
# Postmark:      smtp.postmarkapp.com / 587 / start_tls
# Brevo:         smtp-relay.brevo.com / 587 / start_tls
# SendGrid:      smtp.sendgrid.net / 587 / start_tls
# Amazon SES:    email-smtp.<region>.amazonaws.com / 587 / start_tls
# Mandrill:      smtp.mandrillapp.com / 587 / start_tls
# Mailgun:       smtp.mailgun.org / 587 / start_tls
EMAIL_SMTP_HOST=mailhog
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_CONNECTION=plaintext
EMAIL_SMTP_TIMEOUT=10
# Provider SMTP credentials (MailHog accepts any value; empty credentials crash the router)
EMAIL_SMTP_USERNAME=mailhog
EMAIL_SMTP_PASSWORD=mailhog
# Public dashboard URL — baked into invite/verification/magic-link emails. Must be the
# real public URL in production (NOT localhost) or every link in the email will be dead.
HYPERSWITCH_DASHBOARD_URL=http://localhost:9000
# Public router URL the Control Center talks to (browser reachable).
HYPERSWITCH_PUBLIC_API_URL=http://localhost:8081
# Set to true to enable email-based team invites in the Control Center (requires working email config).
HYPER_EMAIL_ENABLED=false

# Status Page Health Check URLs
# These are used by the /api/health endpoint for the status page.
# Defaults work for local Docker development. Override for production.
HEALTH_CHECK_HYPERSWITCH_URL=http://localhost:8081/health
HEALTH_CHECK_KILLBILL_URL=http://localhost:8082/1.0/healthcheck
HEALTH_CHECK_NATS_URL=http://localhost:8222/healthz
HEALTH_CHECK_TAZAMA_URL=http://localhost:8084/health