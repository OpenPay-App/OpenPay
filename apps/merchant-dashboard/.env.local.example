# Kinde Auth — get these from https://app.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# Paystack — get these from https://dashboard.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_NAME=Core Financial Platform

# ── Hyperswitch (payment orchestration router) ──────────────────────────────
# Phase 3: the dashboard is sandbox/production mode-aware. Credentials are
# resolved per mode via the `openpay_mode` cookie / `?mode=` / `X-OpenPay-Mode`
# header (see src/lib/mode.ts). Per-mode pairs win; the legacy single
# HYPERSWITCH_URL / HYPERSWITCH_API_KEY remains a fallback for existing setups.
#
# Sandbox:
HYPERSWITCH_URL_TEST=http://localhost:8081
HYPERSWITCH_API_KEY_TEST=your_sandbox_secret_key       # e.g. snd_<key_id>-<secret>
NEXT_PUBLIC_OPENPAY_PUBLISHABLE_KEY_TEST=pk_snd_<key_id>-<secret>
# Production (live):
HYPERSWITCH_URL_LIVE=https://router.yourdomain.com
HYPERSWITCH_API_KEY_LIVE=your_live_secret_key          # e.g. prd_<key_id>-<secret>
NEXT_PUBLIC_OPENPAY_PUBLISHABLE_KEY_LIVE=pk_prd_<key_id>-<secret>
#
# Legacy fallback (single-mode installs):
# HYPERSWITCH_URL=http://localhost:8081
# HYPERSWITCH_API_KEY=your_secret_key
# NEXT_PUBLIC_HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_...
# NEXT_PUBLIC_HYPERSWITCH_URL=http://localhost:8081

# Security: never commit real secret keys. The live secret key is only used
# server-side; a production request with no live credential fails fast (503)
# instead of silently reusing sandbox credentials.
