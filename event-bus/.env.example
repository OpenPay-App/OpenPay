# NATS JetStream Configuration

# Server Configuration
NATS_SERVER_NAME=core-nats
NATS_HOST=0.0.0.0
NATS_PORT=4222
NATS_MONITORING_PORT=8222

# JetStream Configuration
JETSTREAM_ENABLED=true
JETSTREAM_STORE_DIR=/data/jetstream
JETSTREAM_MAX_MEMORY=1G
JETSTREAM_MAX_STORAGE=10G

# Authentication
NATS_USER=core-nats-user
NATS_PASSWORD=your_secure_password_here
NATS_ACCOUNT=core-financial

# Clustering (for production)
NATS_CLUSTER_ID=core-nats-cluster
NATS_ROUTES=[]