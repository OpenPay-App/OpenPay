# Kill Bill Subscription & Billing Engine Configuration

# Server Configuration
KILLBILL_HOST=0.0.0.0
KILLBILL_PORT=8080

# Database Configuration (MySQL)
KILLBILL_DATABASE_URL=jdbc:mysql://mysql:3306/killbill
KILLBILL_DATABASE_USER=killbill
KILLBILL_DATABASE_PASSWORD=your_database_password_here

# API Configuration
KILLBILL_API_KEY=your_killbill_api_key_here
KILLBILL_API_SECRET=your_killbill_api_secret_here

# Security Configuration
KILLBILL_SECURITY_KEY=your_security_key_here

# Payment Plugin Configuration
KILLBILL_PLUGIN_HYPERSWITCH_URL=http://hyperswitch:8080

# Paystack Integration (via Hyperswitch)
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Logging Configuration
KILLBILL_LOG_LEVEL=INFO

# NATS Configuration (for event publishing)
NATS_URL=nats://nats:4222
NATS_USER=core-nats-user
NATS_PASSWORD=your_nats_password_here