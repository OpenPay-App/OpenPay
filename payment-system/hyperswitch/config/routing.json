{
  "routing": {
    "type": "priority",
    "data": [
      {
        "type": "connector",
        "connector": "paystack",
        "merchant_connector_id": "paystack_default",
        "weight": 1
      }
    ]
  },
  "rule_engine": {
    "enabled": true,
    "rules": [
      {
        "name": "ngn_card_routing",
        "description": "Route NGN card payments to Paystack",
        "conditions": [
          {
            "field": "currency",
            "operator": "equals",
            "value": "NGN"
          },
          {
            "field": "payment_method",
            "operator": "equals",
            "value": "card"
          }
        ],
        "action": {
          "type": "connector",
          "connector": "paystack"
        }
      },
      {
