# Hyperswitch Payment Orchestration Configuration

# Server Configuration
HYPERSWITCH_HOST=0.0.0.0
HYPERSWITCH_PORT=8080
HYPERSWITCH_ENVIRONMENT=development

# API Configuration
HYPERSWITCH_API_KEY=your_hyperswitch_api_key_here
HYPERSWITCH_API_URL=http://hyperswitch:8080

# Database Configuration (PostgreSQL)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=hyperswitch
DATABASE_USERNAME=hyperswitch_user
DATABASE_PASSWORD=your_database_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Paystack Gateway Configuration
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here
PAYSTACK_API_VERSION=2022-01-01

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# Webhook Configuration
WEBHOOK_URL=http://proxy/webhooks/hyperswitch
WEBHOOK_SECRET=your_webhook_secret_here

# ─── Email Delivery (team invites / verification / magic links) ───
# These override the [email] section in config/docker_compose.toml.
# Dev default points at MailHog; production can use any SMTP provider by
# changing host/port/connection/username/password (Resend, SES, SendGrid...).
# ROUTER__EMAIL__ACTIVE_EMAIL_CLIENT=SMTP
# ROUTER__EMAIL__SENDER_EMAIL=no-reply@yourdomain.com
# ROUTER__EMAIL__SMTP__HOST=mailhog
# ROUTER__EMAIL__SMTP__PORT=1025
# ROUTER__EMAIL__SMTP__CONNECTION=plaintext
# ROUTER__EMAIL__SMTP__TIMEOUT=10
# ROUTER__EMAIL__SMTP__USERNAME=
# ROUTER__EMAIL__SMTP__PASSWORD=
# Public dashboard URL baked into email links (MUST be public in production).
# ROUTER__USER__BASE_URL=http://localhost:9000

# NATS Configuration (for event publishing)
NATS_URL=nats://nats:4222
NATS_USER=core-nats-user
NATS_PASSWORD=your_nats_password_here
# JWT Secret for API authentication
ROUTER__SECRETS__JWT_SECRET=ci-test-jwt-secret-placeholder
