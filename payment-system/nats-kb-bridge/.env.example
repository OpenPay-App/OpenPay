# NATS-KB Bridge Configuration (Paystack Integration)

# NATS Configuration
NATS_URL=nats://nats:4222
NATS_USER=core-nats-user
NATS_PASSWORD=your_nats_password_here
NATS_STREAM=PAYMENT_EVENTS
NATS_CONSUMER=payment-processed

# Kill Bill Configuration
KILLBILL_API_URL=http://killbill:8080
KILLBILL_API_KEY=your_killbill_api_key_here
KILLBILL_API_SECRET=your_killbill_api_secret_here

# Paystack Configuration (for verification)
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Bridge Configuration
BRIDGE_WORKERS=5
BRIDGE_BATCH_SIZE=10
BRIDGE_ACK_TIMEOUT=30s
BRIDGE_MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_CHECK_PORT=8081

# Event Mapping Configuration
EVENT_MAPPING_FILE=/etc/nats-kb-bridge/event-mapping.json